# Supabase — usar la service_role key, no la anon (RLS bloquea los inserts)
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API
# META_ACCESS_TOKEN: token de un system user, sin expiracion
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
# META_WABA_ID: la cuenta de WhatsApp Business que contiene ese numero. Solo
# lo usa scripts/crear_plantillas.py. Ojo: la WABA de pruebas que Meta crea
# sola no es la buena; tiene que ser la que contiene el numero de arriba.
META_WABA_ID=
# META_APP_SECRET: firma de los eventos del webhook (Configuracion basica de
# la app). Sin esto el webhook acepta cualquier POST que conozca la URL, o
# sea que cualquiera puede inyectar un reporte falso.
META_APP_SECRET=

# Clave de la API REST. Sin esto los endpoints de datos responden 503: se
# cierran en vez de quedar abiertos.
API_TOKEN=

# Bucket privado de Supabase Storage donde se archivan las fotos.
# Opcional: si no se define, se usa "fotos-monitoreo".
SUPABASE_BUCKET_FOTOS=fotos-monitoreo

# Hora (0-23) del resumen diario, en hora de Colombia. El diario sale a esta
# hora de lunes a sabado; el semanal, el viernes media hora despues.
HORA_RESUMEN_DIARIO=18

# Twilio — legado, solo lo usa el flujo de labores (pausado)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
