# Supabase — usar la service_role key, no la anon (RLS bloquea los inserts)
SUPABASE_URL=
SUPABASE_KEY=

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Meta WhatsApp Cloud API
# META_ACCESS_TOKEN: token de un system user, sin expiracion
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# Google Drive — destino de las fotos de los reportes
# CLIENT_ID y CLIENT_SECRET: console.cloud.google.com, credencial OAuth de
# tipo "Aplicacion de escritorio".
# REFRESH_TOKEN: lo entrega scripts/autorizar_drive.py (se corre una sola vez).
# FOLDER_ID: opcional, el id de la carpeta destino (va en la URL de Drive
# despues de /folders/). Sin el, las fotos van a la raiz.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Hora (0-23) del resumen diario
HORA_RESUMEN_DIARIO=17

# Twilio — legado, solo lo usa el flujo de labores (pausado)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
